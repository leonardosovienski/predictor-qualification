{
  "schema": "brasileirao/FAILURE_MATRIX/1",
  "frozen_in_phase": "contract-admission (antes de idempotency-failure)",
  "injection": "na borda: morte real do processo brasileirao-research (os._exit 86, sem cleanup) ou falha real do worker supervisionado pelo predictor_ops; nada de mock de Core/Ops",
  "env": "BRASILEIRAO_RESEARCH_FAULT",
  "environments": ["Linux primário (GitHub Actions ubuntu-latest, wheel publicada)", "windows-latest (wheel publicada, informativo)", "Windows local (wheel publicada, runtime D-3)"],
  "expected_invariant": "depois de cada falha, o MESMO pedido reenviado em processo novo produz exatamente 1 efeito de domínio, 1 SUCCEEDED do Ops por job e 1 resultado; resultado incompleto nunca vira resultado válido; nenhuma reparação silenciosa",
  "suite": "tests/conformance/test_failure_recovery.py",
  "cases": [
    {"id": "F01", "class": "crash da admission", "point": "before_admission_commit", "expect": "exit 86; inbox e admissions vazios (a transação aberta morre); reenvio -> RESULT", "test": "test_process_death_at_each_point_recovers_exactly_once[before_admission_commit]"},
    {"id": "F02", "class": "crash depois da admission", "point": "after_admission", "expect": "reenvio -> RESULT (a admission é recibo durável)", "test": "test_process_death_at_each_point_recovers_exactly_once[after_admission]"},
    {"id": "F03", "class": "falha na materialização das referências", "point": "during_materialization", "expect": "reenvio re-verifica os hashes e segue", "test": "test_process_death_at_each_point_recovers_exactly_once[during_materialization]"},
    {"id": "F04", "class": "crash antes do Ops", "point": "before_ops", "expect": "reenvio -> 1 job", "test": "test_process_death_at_each_point_recovers_exactly_once[before_ops]"},
    {"id": "F05", "class": "crash do host depois do Ops (efeito já gravado)", "point": "after_ops", "expect": "reenvio: o Ops devolve SKIPPED economic_operation_already_claimed; efeito reaproveitado; 1 SUCCEEDED", "test": "test_process_death_at_each_point_recovers_exactly_once[after_ops]"},
    {"id": "F06", "class": "falha depois do artefato de previsão", "point": "after_domain_effect", "expect": "efeito verificado por hash e reaproveitado", "test": "test_process_death_at_each_point_recovers_exactly_once[after_domain_effect]"},
    {"id": "F07", "class": "falha na gravação do resultado (parcial)", "point": "during_result_write", "expect": "arquivo parcial .tmp nunca é resultado; o hash do resultado é journalado antes; reenvio regrava os mesmos bytes", "test": "test_process_death_at_each_point_recovers_exactly_once[during_result_write]"},
    {"id": "F08", "class": "falha na composição do resultado antes do índice", "point": "after_result_write", "expect": "reenvio indexa o mesmo resultado", "test": "test_process_death_at_each_point_recovers_exactly_once[after_result_write]"},
    {"id": "F09", "class": "crash depois do índice", "point": "after_result_store", "expect": "reenvio -> RESULT/DUPLICATE; journal COMPLETED", "test": "test_process_death_at_each_point_recovers_exactly_once[after_result_store]"},
    {"id": "F10", "class": "crash do job do Ops (o worker morre)", "point": "ops_worker_crash", "expect": "OPS_FAILED_RETRYABLE, operational FAILED, científico/econômico NOT_EVALUATED; retry -> RESULT", "test": "test_ops_worker_crash_is_not_a_result_and_retry_succeeds"},
    {"id": "F11", "class": "timeout do Ops", "point": "ops_worker_hang (timeout 3 s na policy)", "expect": "o Ops mata a árvore, exit 124, termination.reason timeout; OPS_FAILED_RETRYABLE TIMEOUT; nenhum efeito", "test": "test_ops_timeout_kills_the_worker_and_is_not_a_result"},
    {"id": "F12", "class": "worker lento", "point": "ops_worker_slow", "expect": "1 resultado", "test": "test_slow_worker_still_produces_exactly_one_result"},
    {"id": "F13", "class": "orçamento de retries esgotado", "point": "ops_worker_crash x (max_retries+1)", "expect": "resultado terminal FAILED_OPERATIONAL, sem estado científico/econômico", "test": "test_retry_budget_exhaustion_is_a_terminal_operational_failure"},
    {"id": "F14", "class": "lock do Ops ocupado por outra execução", "point": "run.lock de dono vivo", "expect": "SKIPPED lock_not_acquired -> OPS_FAILED_RETRYABLE; nenhum efeito; depois -> RESULT", "test": "test_ops_lock_held_by_another_run_is_retryable_never_a_second_effect"},
    {"id": "F15", "class": "DB lock", "point": "results.sqlite com BEGIN EXCLUSIVE de outra conexão por 4 s", "expect": "espera (timeout 30 s) e completa 1 vez", "test": "test_database_lock_waits_and_then_completes_once"},
    {"id": "F16", "class": "pedido duplicado concorrente", "point": "2 processos, mesmo pedido", "expect": "1 efeito, 1 SUCCEEDED, 1 resultado", "test": "test_concurrent_submissions_of_the_same_request_produce_one_effect"},
    {"id": "F17", "class": "pedidos fora de ordem", "point": "janela posterior antes da anterior", "expect": "resultados independentes e iguais aos da ordem natural", "test": "test_out_of_order_requests_are_independent_and_deterministic"},
    {"id": "F18", "class": "DB x FS divergentes (o índice diz que existe, o arquivo sumiu)", "point": "research-result.json apagado", "expect": "RECONCILIATION_REQUIRED, sem reparar", "test": "test_db_says_result_exists_but_file_is_gone"},
    {"id": "F19", "class": "DB x FS divergentes (o arquivo existe, o índice perdeu)", "point": "DELETE FROM results", "expect": "RECONCILIATION_REQUIRED, sem reindexar", "test": "test_file_exists_but_index_lost_the_result"},
    {"id": "F20", "class": "artefato corrompido (resultado e efeito)", "point": "bytes alterados", "expect": "show exit 5; EFFECT_HASH_MISMATCH", "test": "test_modified_result_and_modified_effect_fail_closed"},
    {"id": "F21", "class": "snapshot com hash divergente", "point": "blob SQLite alterado no object store", "expect": "RECONCILIATION_REQUIRED antes do Ops", "test": "test_corrupted_dataset_snapshot_in_the_object_store_fails_before_ops"},
    {"id": "F22", "class": "artefato ausente", "point": "objeto de referência apagado", "expect": "NOT_READY (exit 3)", "test": "test_missing_reference_object_is_not_ready"},
    {"id": "F23", "class": "artefato alterado depois da materialização", "point": "dataset.sqlite3 materializado alterado", "expect": "RECONCILIATION_REQUIRED (changed after materialization)", "test": "test_reference_changed_after_materialization_fails_closed"},
    {"id": "F24", "class": "backup/restore", "point": "bundle + restore em raiz nova", "expect": "mesmos bytes do resultado", "test": "test_backup_and_restore_into_a_new_root_reread_the_same_result"}
  ]
}
